# FIELD backend configuration.
# Copy to .env and fill in your own values. Never commit .env.
# All values below are placeholders or safe defaults, never real credentials.

# Backend
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite:///./field.db
FRONTEND_ORIGIN=http://localhost:5173

# Meta Model API — obtain credentials independently, verify model IDs in docs
META_MODEL_API_KEY=replace_with_your_own_key
META_MODEL_BASE_URL=replace_with_verified_endpoint
MUSE_SPARK_MODEL_ID=replace_with_verified_model_id
MUSE_TRANSCRIBE_MODEL_ID=replace_with_verified_model_id

# Modal / Muse Glimmer — server-side only
MODAL_ENDPOINT_URL=replace_with_your_own_endpoint
MODAL_API_KEY=replace_with_your_own_key

# E2B — server-side only
E2B_API_KEY=replace_with_your_own_key

# Azure Speech — optional TTS
AZURE_SPEECH_KEY=replace_with_your_own_key
AZURE_SPEECH_REGION=replace_with_your_region

# Optional storage configuration
MEDIA_STORAGE_PATH=./uploads
MAX_UPLOAD_SIZE_MB=100

# Background builds: run POST /build via the SQLite-backed worker
# (max 1 concurrent build) instead of blocking the request. Default off.
BUILD_ASYNC=false
